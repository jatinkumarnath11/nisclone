{
  "name": "university-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade, real-time University Management System (UMS) Monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @ums/database db:generate",
    "db:push": "pnpm --filter @ums/database db:push",
    "db:migrate": "pnpm --filter @ums/database db:migrate",
    "db:seed": "pnpm --filter @ums/database db:seed",
    "db:studio": "pnpm --filter @ums/database db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "ts-node scripts/setup.ts",
    "health": "ts-node scripts/health-check.ts"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2"
  },
  "packageManager": "pnpm@9.12.0"
}
