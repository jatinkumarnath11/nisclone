# ==============================================================================
# UNIVERSITY MANAGEMENT SYSTEM (UMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://ums_user:ums_secure_password_dev@localhost:5432/ums_dev?schema=public

# Redis Configuration (Caching, BullMQ, Real-time Socket.IO Adapter)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
# Generate secure 64-char strings in production: openssl rand -base64 48
JWT_SECRET=ums_dev_access_token_secret_replace_in_production_key_32bytes!
JWT_REFRESH_SECRET=ums_dev_refresh_token_secret_replace_in_production_key_32bytes!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Public Variables
NEXT_PUBLIC_APP_NAME="Apex University"
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# File Storage (S3 / Local Object Storage Compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ums-documents
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_key_change_me
UPLOAD_MAX_FILE_SIZE_MB=25

# Email & Notifications (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASSWORD=mock_smtp_password
SMTP_FROM_EMAIL=no-reply@apex-university.edu
SMTP_FROM_NAME="Apex University Portal"

# Super Admin Initial Credentials (Used exclusively by seed.ts)
ADMIN_INITIAL_EMAIL=admin@ums.edu
ADMIN_INITIAL_PASSWORD=AdminSecurePassword123!
